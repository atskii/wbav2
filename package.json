{
  "name": "wba",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "vite",
    "dev": "concurrently -n \"APP,TOKENS,USERS\" -c \"cyan,magenta,green\" \"vite --force --clearScreen false\" \"vite --config vite.analytics.config.js --force --clearScreen false\" \"vite --config vite.users.config.js --force --clearScreen false\"",
    "dev:app": "vite",
    "dev:analytics": "vite --config vite.analytics.config.js",
    "dev:users": "vite --config vite.users.config.js",
    "build": "vite build",
    "preview": "vite preview",
    "audit:check": "npm audit",
    "sbom:generate": "npx @cyclonedx/cyclonedx-npm --output-format JSON --output-file bom.json"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.4",
    "postcss": "^8.5.12",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10"
  }
}
